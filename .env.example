# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Public app URL (used for invite links and push notification subject)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — required for AI weekly summary feature
OPENAI_API_KEY=<openai-api-key>

# Internal API secret — protects /api/push/send from external callers
# Set to any long random string
INTERNAL_API_SECRET=<random-secret>

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:<admin-email>
